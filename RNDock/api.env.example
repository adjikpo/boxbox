# =====================================================
# API Backend Environment Variables Template
# =====================================================
# Copy this file to `.env` and update the values
# NEVER commit .env to Git, only .env.example

# =====================================================
# Server Configuration
# =====================================================

# Port on which the API listens
PORT=4000

# Environment (development / staging / production)
NODE_ENV=development

# =====================================================
# Authentication & Security
# =====================================================

# JWT Secret for token signing (min 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-min-32-chars-change-me-in-prod

# Token expiration time (e.g., 7d, 24h, 1w)
JWT_EXPIRES_IN=7d

# =====================================================
# CORS Configuration
# =====================================================

# Comma-separated list of allowed origins
# Format: http://localhost:8081,http://localhost:19006,http://192.168.1.27:19006
CORS_ORIGIN=http://localhost:8081,http://localhost:19006,http://localhost:5173

# =====================================================
# Database
# =====================================================

# SQLite database path
DB_PATH=./data/ledgertrack.db

# =====================================================
# Optional: External Services
# =====================================================

# Example: Stripe
# STRIPE_API_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Example: SendGrid (email)
# SENDGRID_API_KEY=SG....

# Example: AWS
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# =====================================================
# Logging
# =====================================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# =====================================================
# Rate Limiting
# =====================================================

# Requests per minute per IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
